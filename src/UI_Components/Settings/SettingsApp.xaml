<Page
    x:Class="Windows12.UI_Components.Settings.SettingsApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource SurfaceBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{ThemeResource TaskbarBackgroundBrush}" Padding="20">
            <StackPanel Spacing="6">
                <TextBlock Text="Settings" FontSize="32" FontWeight="Bold" Margin="0,0,0,24"/>
                <Button Content="System" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="Personalization" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="Apps" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="Time Travel" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="Dev Workspace" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="Privacy & Security" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="Windows Update" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="About" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="48">
            <StackPanel Spacing="28" MaxWidth="860">
                <TextBlock Text="System" FontSize="36" FontWeight="SemiBold"/>
                <TextBlock Text="Windows 12 Project Rebirth • Build 2026.10.31" Opacity="0.65"/>

                <Border Background="{ThemeResource ElevatedSurfaceBrush}" CornerRadius="20" Padding="24">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Display & Theme" FontWeight="SemiBold" FontSize="20"/>
                        <ToggleSwitch Header="Rectify12 Theme" IsOn="True"/>
                        <ToggleSwitch Header="Floating Taskbar" IsOn="True"/>
                        <ToggleSwitch Header="Dark Carbon Mode" IsOn="False"/>
                        <Slider Header="Animation Refresh Rate" Minimum="60" Maximum="144" Value="120"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource ElevatedSurfaceBrush}" CornerRadius="20" Padding="24">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Time-Travel Engine" FontWeight="SemiBold" FontSize="20"/>
                        <ToggleSwitch Header="Automatic Snapshots" IsOn="True"/>
                        <Button Content="Create Snapshot Now"/>
                        <Button Content="View History"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource ElevatedSurfaceBrush}" CornerRadius="20" Padding="24">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Privacy" FontWeight="SemiBold" FontSize="20"/>
                        <ToggleSwitch Header="Disable All Telemetry" IsOn="True"/>
                        <ToggleSwitch Header="Local NPU Only" IsOn="True"/>
                        <TextBlock Text="All AI and search stay on-device." Opacity="0.7" FontSize="13"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
