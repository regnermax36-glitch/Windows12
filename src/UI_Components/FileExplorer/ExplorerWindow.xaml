<Page
    x:Class="Windows12.UI_Components.FileExplorer.ExplorerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource SurfaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource TaskbarBackgroundBrush}" Padding="16,10" CornerRadius="0,0,16,16">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="New" Style="{ThemeResource ModernButtonStyle}"/>
                <Button Content="Cut" Style="{ThemeResource ModernButtonStyle}"/>
                <Button Content="Copy" Style="{ThemeResource ModernButtonStyle}"/>
                <Button Content="Paste" Style="{ThemeResource ModernButtonStyle}"/>
                <TextBox Width="320" PlaceholderText="Search this PC..." CornerRadius="10" Height="36"/>
                <Button Content="View" Style="{ThemeResource ModernButtonStyle}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource TaskbarBackgroundBrush}" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="This PC" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock Text="Quick Access" Margin="8,4"/>
                    <TextBlock Text="Desktop" Margin="8,4"/>
                    <TextBlock Text="Documents" Margin="8,4"/>
                    <TextBlock Text="Downloads" Margin="8,4"/>
                    <TextBlock Text="Dev Workspace" Margin="8,4"/>
                    <TextBlock Text="Time Travel Snapshots" Margin="8,4"/>
                </StackPanel>
            </Border>

            <GridView Grid.Column="1" Padding="24">
                <GridViewItem>
                    <StackPanel Width="110" Height="110">
                        <FontIcon Glyph="&#xE8B7;" FontSize="52" HorizontalAlignment="Center"/>
                        <TextBlock Text="Projects" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </GridViewItem>
                <GridViewItem>
                    <StackPanel Width="110" Height="110">
                        <FontIcon Glyph="&#xE8A5;" FontSize="52" HorizontalAlignment="Center"/>
                        <TextBlock Text="Windows12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </GridViewItem>
                <GridViewItem>
                    <StackPanel Width="110" Height="110">
                        <FontIcon Glyph="&#xE943;" FontSize="52" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kernel" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </GridViewItem>
            </GridView>
        </Grid>
    </Grid>
</Page>
