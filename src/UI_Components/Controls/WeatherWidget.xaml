<UserControl
    x:Class="Windows12.UI_Components.Controls.WeatherWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource ElevatedSurfaceBrush}" CornerRadius="16" Padding="16">
        <StackPanel>
            <TextBlock Text="72°" FontSize="32" FontWeight="Light"/>
            <TextBlock Text="Sunny" Opacity="0.7"/>
        </StackPanel>
    </Border>
</UserControl>
