<Page
    x:Class="Windows12.UI_Components.Shell.DesktopShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0D0D0D">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- Desktop area -->
        <Grid Grid.Row="0" Background="#0D0D0D">
            <TextBlock Text="Windows 12 Desktop" FontSize="24" Foreground="#444444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Taskbar -->
        <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="12,12,0,0" Margin="8,0,8,4">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Button Content="Start" Width="40" Height="32" Background="#0078D4" Foreground="White" CornerRadius="6"/>
                    <Button Content="Search" Width="60" Height="32" Background="#2A2A2A" Foreground="White" CornerRadius="6"/>
                    <Button Content="Explorer" Width="70" Height="32" Background="#2A2A2A" Foreground="White" CornerRadius="6"/>
                    <Button Content="Settings" Width="70" Height="32" Background="#2A2A2A" Foreground="White" CornerRadius="6"/>
                </StackPanel>
                <TextBlock Text="12:00" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="White"/>
            </Grid>
        </Border>
    </Grid>
</Page>
