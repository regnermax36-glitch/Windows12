<Page
    x:Class="Windows12.UI_Components.Shell.DesktopShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0A0A0A">
        <!-- Desktop wallpaper area -->
        <Grid x:Name="DesktopArea" Background="#0A0A0A">
            <TextBlock Text="Windows 12" FontSize="72" FontWeight="Light" Foreground="#1A1A1A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80"/>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24" Spacing="12">
                <Button Content="This PC" Width="80" Height="72" Background="Transparent" Foreground="White" Click="DesktopIcon_Click" Tag="Explorer"/>
                <Button Content="Recycle Bin" Width="80" Height="72" Background="Transparent" Foreground="White" Click="DesktopIcon_Click" Tag="Recycle"/>
                <Button Content="Settings" Width="80" Height="72" Background="Transparent" Foreground="White" Click="DesktopIcon_Click" Tag="Settings"/>
            </StackPanel>
        </Grid>

        <!-- App content frame (overlays desktop) -->
        <Frame x:Name="ContentFrame" Visibility="Collapsed" Background="#1E1E1E" Margin="0,0,0,72"/>

        <!-- Start Menu overlay -->
        <Border x:Name="StartMenu" Visibility="Collapsed" Background="#1A1A1A" CornerRadius="16" Margin="0,0,0,80" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="640" Height="540" BorderBrush="#333333" BorderThickness="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Start" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>
                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="8">
                        <Button Content="File Explorer" Height="40" HorizontalAlignment="Stretch" Background="#2A2A2A" Foreground="White" CornerRadius="8" Click="StartApp_Click" Tag="Explorer"/>
                        <Button Content="Settings" Height="40" HorizontalAlignment="Stretch" Background="#2A2A2A" Foreground="White" CornerRadius="8" Click="StartApp_Click" Tag="Settings"/>
                        <Button Content="Microsoft Edge" Height="40" HorizontalAlignment="Stretch" Background="#2A2A2A" Foreground="White" CornerRadius="8" Click="StartApp_Click" Tag="Browser"/>
                        <Button Content="Notepad" Height="40" HorizontalAlignment="Stretch" Background="#2A2A2A" Foreground="White" CornerRadius="8" Click="StartApp_Click" Tag="Notepad"/>
                        <Button Content="Calculator" Height="40" HorizontalAlignment="Stretch" Background="#2A2A2A" Foreground="White" CornerRadius="8" Click="StartApp_Click" Tag="Calculator"/>
                        <Button Content="Terminal" Height="40" HorizontalAlignment="Stretch" Background="#2A2A2A" Foreground="White" CornerRadius="8" Click="StartApp_Click" Tag="Terminal"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Power" Width="80" Height="32" Background="#333333" Foreground="White" CornerRadius="6" Click="Power_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Floating Taskbar -->
        <Border x:Name="Taskbar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Background="#1A1A1A" CornerRadius="16" Padding="8,4" BorderBrush="#333333" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="StartButton" Content="🏠" Width="40" Height="40" Background="Transparent" Foreground="White" CornerRadius="8" Click="StartButton_Click"/>
                <Button Content="🔍" Width="40" Height="40" Background="Transparent" Foreground="White" CornerRadius="8" Click="Search_Click"/>
                <Button Content="📁" Width="40" Height="40" Background="Transparent" Foreground="White" CornerRadius="8" Click="Explorer_Click"/>
                <Button Content="⚙️" Width="40" Height="40" Background="Transparent" Foreground="White" CornerRadius="8" Click="Settings_Click"/>
                <Border Width="1" Height="24" Background="#333333" Margin="8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ClockText" Text="12:00" VerticalAlignment="Center" Foreground="White" Margin="8,0" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
