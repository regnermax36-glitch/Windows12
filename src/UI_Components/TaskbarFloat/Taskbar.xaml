<UserControl
    x:Class="Windows12.UI_Components.TaskbarFloat.Taskbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource TaskbarBackgroundBrush}"
            CornerRadius="32"
            BorderThickness="1.5"
            BorderBrush="{ThemeResource TaskbarBorderBrush}"
            Padding="22,12"
            Shadow="{ThemeResource FloatingElevationShadow}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,18">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Width="56" Height="56" CornerRadius="18" Background="Transparent" ToolTipService.ToolTip="Start">
                    <FontIcon Glyph="&#xE7EF;" FontSize="24"/>
                </Button>
                <Button Width="48" Height="48" CornerRadius="14" Background="Transparent" ToolTipService.ToolTip="Search">
                    <FontIcon Glyph="&#xE721;" FontSize="20"/>
                </Button>
                <Button Width="48" Height="48" CornerRadius="14" Background="Transparent" ToolTipService.ToolTip="Task View">
                    <FontIcon Glyph="&#xE7C4;" FontSize="20"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" VerticalAlignment="Center">
                <Button Width="48" Height="48" CornerRadius="14" Background="Transparent" ToolTipService.ToolTip="Explorer">
                    <FontIcon Glyph="&#xE8B7;" FontSize="22"/>
                </Button>
                <Button Width="48" Height="48" CornerRadius="14" Background="Transparent" ToolTipService.ToolTip="Terminal">
                    <FontIcon Glyph="&#xE756;" FontSize="22"/>
                </Button>
                <Button Width="48" Height="48" CornerRadius="14" Background="Transparent" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="22"/>
                </Button>
                <Button Width="48" Height="48" CornerRadius="14" Background="Transparent" ToolTipService.ToolTip="Copilot">
                    <FontIcon Glyph="&#xE7F4;" FontSize="22"/>
                </Button>
                <Button Width="48" Height="48" CornerRadius="14" Background="Transparent" ToolTipService.ToolTip="Widgets">
                    <FontIcon Glyph="&#xE713;" FontSize="22"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Width="40" Height="40" Background="Transparent" ToolTipService.ToolTip="Notifications">
                    <FontIcon Glyph="&#xE7E7;" FontSize="18"/>
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="4,0">
                    <TextBlock Text="16:27" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="Oct 31" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>
                <Button Width="40" Height="40" Background="Transparent" ToolTipService.ToolTip="Quick Settings">
                    <FontIcon Glyph="&#xE7F4;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
