<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="SunsetDesktopBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7EB9" Offset="0.0"/>
        <GradientStop Color="#FFD166" Offset="0.5"/>
        <GradientStop Color="#FF9A76" Offset="1.0"/>
    </LinearGradientBrush>

    <AcrylicBrush x:Key="TaskbarBackgroundBrush" TintColor="#FFFFFF" TintOpacity="0.7" FallbackColor="#CCFFFFFF"/>
    <AcrylicBrush x:Key="SurfaceBackgroundBrush" TintColor="#FFFFFF" TintOpacity="0.85" FallbackColor="#E6FFFFFF"/>
    <SolidColorBrush x:Key="TaskbarBorderBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#F0FFFFFF"/>
    
    <SolidColorBrush x:Key="PrimaryIconColor" Color="#FF111111"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="AccentColorBrush" Color="#FF7EB9"/>

    <ThemeShadow x:Key="FloatingElevationShadow"/>

    <Style x:Key="PowerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style x:Key="AccentPowerButtonStyle" TargetType="Button" BasedOn="{StaticResource PowerButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentColorBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
</ResourceDictionary>
