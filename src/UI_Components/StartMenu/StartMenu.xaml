<UserControl
    x:Class="Windows12.UI_Components.StartMenu.StartMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Windows12.UI_Components.StartMenu">

    <Border Background="{ThemeResource SurfaceBackgroundBrush}" 
            CornerRadius="24" 
            Width="720" Height="820" 
            BorderThickness="1.5" 
            BorderBrush="{ThemeResource TaskbarBorderBrush}"
            Padding="28"
            Shadow="{ThemeResource FloatingElevationShadow}">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBox PlaceholderText="Search apps, settings, files, or ask Copilot..." 
                         Height="52" CornerRadius="12" FontSize="16"
                         Background="{ThemeResource SearchBackgroundBrush}"/>
                <FontIcon Glyph="&#xE721;" FontSize="20" HorizontalAlignment="Right" 
                          Margin="0,0,16,0" VerticalAlignment="Center" 
                          Foreground="{ThemeResource PrimaryIconColor}"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,24">
                <Ellipse Width="40" Height="40" Fill="{ThemeResource AccentColorBrush}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Power User" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Local Account • No Telemetry" FontSize="12" Opacity="0.7"/>
                </StackPanel>
                <Button Content="Switch" Background="Transparent" HorizontalAlignment="Right" Margin="auto,0,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">
                    <TextBlock Text="Pinned" FontWeight="SemiBold" FontSize="18" Margin="4,0"/>
                    <GridView>
                        <GridViewItem><local:AppTile Icon="&#xE756;" Name="Terminal" /></GridViewItem>
                        <GridViewItem><local:AppTile Icon="&#xE8B7;" Name="Explorer" /></GridViewItem>
                        <GridViewItem><local:AppTile Icon="&#xE943;" Name="Dev Workspace" /></GridViewItem>
                        <GridViewItem><local:AppTile Icon="&#xE70F;" Name="Settings" /></GridViewItem>
                        <GridViewItem><local:AppTile Icon="&#xE8A5;" Name="Store" /></GridViewItem>
                        <GridViewItem><local:AppTile Icon="&#xE7F4;" Name="Copilot" /></GridViewItem>
                        <GridViewItem><local:AppTile Icon="&#xE8F1;" Name="Time Travel" /></GridViewItem>
                        <GridViewItem><local:AppTile Icon="&#xE713;" Name="Widgets" /></GridViewItem>
                    </GridView>

                    <TextBlock Text="Recommended" FontWeight="SemiBold" FontSize="18" Margin="4,12,0,0"/>
                    <ListView>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8B7;" FontSize="24"/>
                                <StackPanel>
                                    <TextBlock Text="Project Documents" FontWeight="Medium"/>
                                    <TextBlock Text="Opened yesterday" FontSize="12" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE943;" FontSize="24"/>
                                <StackPanel>
                                    <TextBlock Text="Kernel Profiler Session" FontWeight="Medium"/>
                                    <TextBlock Text="Dev Mode active" FontSize="12" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Sleep" Style="{ThemeResource PowerButtonStyle}"/>
                    <Button Content="Restart" Style="{ThemeResource PowerButtonStyle}"/>
                    <Button Content="Shutdown" Style="{ThemeResource AccentPowerButtonStyle}"/>
                </StackPanel>
                <Button HorizontalAlignment="Left" Background="Transparent" Content="All Apps" FontWeight="SemiBold"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
