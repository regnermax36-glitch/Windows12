<UserControl
    x:Class="Windows12.UI_Components.StartMenu.StartMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource SurfaceBackgroundBrush}"
            CornerRadius="28"
            Width="760" Height="860"
            BorderThickness="1.5"
            BorderBrush="{ThemeResource TaskbarBorderBrush}"
            Padding="32">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{ThemeResource SearchBackgroundBrush}" CornerRadius="16" Height="56" Margin="0,0,0,20">
                <Grid>
                    <TextBox PlaceholderText="Search apps, settings, files, or ask Copilot..." BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Margin="16,0" FontSize="16"/>
                    <FontIcon Glyph="&#xE721;" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center" FontSize="20"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Margin="0,0,0,24">
                <Ellipse Width="44" Height="44" Fill="{ThemeResource AccentColorBrush}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Power User" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Local • Telemetry Off" FontSize="12" Opacity="0.65"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="2">
                <StackPanel Spacing="24">
                    <TextBlock Text="Pinned" FontWeight="SemiBold" FontSize="20"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Spacing="6" Width="90" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Explorer" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Width="90" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE756;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Terminal" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Width="90" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE70F;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Width="90" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7F4;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Copilot" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Width="90" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE943;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Dev Mode" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Width="90" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8F1;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Time Travel" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Recommended" FontWeight="SemiBold" FontSize="20" Margin="0,8,0,0"/>
                    <ListView>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8B7;" FontSize="24"/>
                                <StackPanel>
                                    <TextBlock Text="Project Documents" FontWeight="Medium"/>
                                    <TextBlock Text="Opened recently" FontSize="12" Opacity="0.6"/>
                                </StackPanel>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Button HorizontalAlignment="Left" Content="All Apps" Background="Transparent" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Sleep"/>
                    <Button Content="Restart"/>
                    <Button Content="Shutdown"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
