<Page
    x:Class="Windows12.UI_Components.Installer.InstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1E1E1E" Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Windows 12 Project Rebirth" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="0" Text="No Bloat. No Telemetry. Full Control." FontSize="14" Foreground="#888888" Margin="0,36,0,0"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="16">
            <TextBlock x:Name="StatusText" Text="Ready to install." FontSize="18" Foreground="White" TextWrapping="Wrap"/>
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="False" Value="0" Maximum="100" Height="8"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button x:Name="InstallButton" Content="Install" Width="120" Height="40" Click="InstallButton_Click"/>
            <Button x:Name="ShellButton" Content="Launch Shell" Width="140" Height="40" Click="ShellButton_Click" Visibility="Collapsed"/>
            <Button Content="Close" Width="100" Height="40" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
