<UserControl
    x:Class="Windows12.UI_Components.Widgets.AdvancedWidgetBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="20" Padding="16" Shadow="{ThemeResource FloatingElevationShadow}">
        <StackPanel Spacing="12">
            <TextBlock Text="Widgets" FontSize="18" FontWeight="SemiBold"/>
            <Border Background="{ThemeResource TaskbarBackgroundBrush}" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Weather" FontWeight="Medium"/>
                    <TextBlock Text="72°F • Sunny" FontSize="24" FontWeight="Light"/>
                    <TextBlock Text="Local NPU forecast" FontSize="11" Opacity="0.6"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource TaskbarBackgroundBrush}" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Time Travel" FontWeight="Medium"/>
                    <TextBlock Text="Last snapshot: 14:28" FontSize="14"/>
                    <Button Content="Rollback" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource TaskbarBackgroundBrush}" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Dev Workspace" FontWeight="Medium"/>
                    <TextBlock Text="Mode: Active • Telemetry Off" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
