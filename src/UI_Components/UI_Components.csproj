<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Windows12.UI_Components</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseRidGraph>true</UseRidGraph>
    
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>

    <!-- Prevent bootstrapper from showing "Windows App Runtime not found" on self-contained apps -->
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>false</WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>

    <!-- Disable MSIX / PRI tooling that fails on GitHub Actions -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackage>false</AppxPackage>

    <!-- Avoid trimming that can break WinUI at runtime -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240404000" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.2.0" />
  </ItemGroup>

  <!-- Permanently exclude old complex trees that crash XamlCompiler -->
  <ItemGroup>
    <Page Remove="Apps\**\*.xaml" />
    <Page Remove="Desktop\**\*.xaml" />
    <Page Remove="StartMenu\**\*.xaml" />
    <Page Remove="TaskbarFloat\**\*.xaml" />
    <Page Remove="Settings\**\*.xaml" />
    <Page Remove="FileExplorer\**\*.xaml" />
    <Page Remove="Widgets\**\*.xaml" />
    <Page Remove="Copilot\**\*.xaml" />
    <Page Remove="LockScreen\**\*.xaml" />
    <Page Remove="NotificationCenter\**\*.xaml" />
    <Page Remove="Snap\**\*.xaml" />
    <Page Remove="Themes\**\*.xaml" />
    <Compile Remove="Apps\**\*.cs" />
    <Compile Remove="Desktop\**\*.cs" />
    <Compile Remove="StartMenu\**\*.cs" />
    <Compile Remove="TaskbarFloat\**\*.cs" />
    <Compile Remove="Settings\**\*.cs" />
    <Compile Remove="FileExplorer\**\*.cs" />
    <Compile Remove="Widgets\**\*.cs" />
    <Compile Remove="Copilot\**\*.cs" />
    <Compile Remove="LockScreen\**\*.cs" />
    <Compile Remove="NotificationCenter\**\*.cs" />
    <Compile Remove="Snap\**\*.cs" />
  </ItemGroup>
</Project>
