<Page
    x:Class="Windows12.UI_Components.Desktop.Desktop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Windows12.UI_Components.Desktop"
    xmlns:taskbar="using:Windows12.UI_Components.TaskbarFloat"
    xmlns:widgets="using:Windows12.UI_Components.Widgets"
    xmlns:start="using:Windows12.UI_Components.StartMenu">

    <Grid Background="{ThemeResource SunsetDesktopBackground}">
        <Canvas x:Name="IconCanvas">
            <local:DesktopIcon Canvas.Left="32" Canvas.Top="32" Icon="&#xE8B7;" Label="This PC"/>
            <local:DesktopIcon Canvas.Left="32" Canvas.Top="130" Icon="&#xE8A5;" Label="Windows12"/>
            <local:DesktopIcon Canvas.Left="32" Canvas.Top="228" Icon="&#xE943;" Label="Dev Workspace"/>
            <local:DesktopIcon Canvas.Left="32" Canvas.Top="326" Icon="&#xE8F1;" Label="Time Travel"/>
            <local:DesktopIcon Canvas.Left="32" Canvas.Top="424" Icon="&#xE70F;" Label="Settings"/>
            <local:DesktopIcon Canvas.Left="140" Canvas.Top="32" Icon="&#xE7F4;" Label="Copilot"/>
            <local:DesktopIcon Canvas.Left="140" Canvas.Top="130" Icon="&#xE713;" Label="Widgets"/>
        </Canvas>

        <widgets:AdvancedWidgetBoard HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,48,0" Width="380"/>

        <start:StartMenu x:Name="StartMenuOverlay" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,100" Visibility="Collapsed"/>

        <taskbar:Taskbar HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
    </Grid>
</Page>
