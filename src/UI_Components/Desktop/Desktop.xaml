<Page
    x:Class="Windows12.UI_Components.Desktop.Desktop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:taskbar="using:Windows12.UI_Components.TaskbarFloat"
    xmlns:widgets="using:Windows12.UI_Components.Widgets"
    xmlns:start="using:Windows12.UI_Components.StartMenu">

    <Grid Background="{ThemeResource SunsetDesktopBackground}">
        <Canvas x:Name="IconCanvas">
            <StackPanel Canvas.Left="32" Canvas.Top="32" Spacing="4">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="This PC" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <StackPanel Canvas.Left="32" Canvas.Top="130" Spacing="4">
                <FontIcon Glyph="&#xE8A5;" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Windows12" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <StackPanel Canvas.Left="32" Canvas.Top="228" Spacing="4">
                <FontIcon Glyph="&#xE943;" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Dev Workspace" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <StackPanel Canvas.Left="32" Canvas.Top="326" Spacing="4">
                <FontIcon Glyph="&#xE8F1;" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Time Travel" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <StackPanel Canvas.Left="32" Canvas.Top="424" Spacing="4">
                <FontIcon Glyph="&#xE70F;" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Settings" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <StackPanel Canvas.Left="140" Canvas.Top="32" Spacing="4">
                <FontIcon Glyph="&#xE7F4;" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Copilot" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <StackPanel Canvas.Left="140" Canvas.Top="130" Spacing="4">
                <FontIcon Glyph="&#xE713;" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Widgets" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Canvas>

        <widgets:AdvancedWidgetBoard HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,48,0" Width="380"/>

        <start:StartMenu x:Name="StartMenuOverlay" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,100" Visibility="Collapsed"/>

        <taskbar:Taskbar HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
    </Grid>
</Page>
