<Page
    x:Class="Windows12.UI_Components.Desktop.Desktop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:widgets="using:Windows12.UI_Components.Widgets">

    <Grid Background="{ThemeResource SunsetDesktopBackground}">
        <Canvas>
            <StackPanel Canvas.Left="40" Canvas.Top="40" Spacing="4" Width="80">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="This PC" HorizontalAlignment="Center" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Canvas.Left="40" Canvas.Top="140" Spacing="4" Width="80">
                <FontIcon Glyph="&#xE8A5;" FontSize="40" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="Windows12" HorizontalAlignment="Center" Foreground="White" FontSize="12"/>
            </StackPanel>
            <StackPanel Canvas.Left="40" Canvas.Top="240" Spacing="4" Width="80">
                <FontIcon Glyph="&#xE943;" FontSize="40" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="Dev Mode" HorizontalAlignment="Center" Foreground="White" FontSize="12"/>
            </StackPanel>
        </Canvas>
        <widgets:WidgetCanvas HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,40,0" Width="360" Height="480"/>
    </Grid>
</Page>
