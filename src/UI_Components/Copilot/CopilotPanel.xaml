<UserControl
    x:Class="Windows12.UI_Components.Copilot.CopilotPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="20" Width="420" Height="640" Padding="20" Shadow="{ThemeResource FloatingElevationShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Copilot (Local NPU)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="12">
                    <Border Background="{ThemeResource TaskbarBackgroundBrush}" CornerRadius="12" Padding="12" HorizontalAlignment="Left" MaxWidth="300">
                        <TextBlock Text="How can I help with your Dev Workspace today?" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <TextBox Grid.Row="2" PlaceholderText="Ask anything (runs on-device)..." Height="48" CornerRadius="12" Margin="0,12,0,0"/>
        </Grid>
    </Border>
</UserControl>
